#!/bin/sh
# Repository pre-commit checks (enabled by scripts/install-hooks.mjs).
# 1) Block commits that contain credentials. 2) Refresh the graphify code graph into the commit.

node scripts/check-secrets.mjs --staged || {
  echo "Commit blocked: remove the credential shown above, or unstage that file." >&2
  exit 1
}

GRAPHIFY="$(command -v graphify 2>/dev/null || echo "$HOME/.local/bin/graphify")"
if [ ! -x "$GRAPHIFY" ]; then
  echo "graphify not installed; skipping graph refresh" >&2
  exit 0
fi
if "$GRAPHIFY" update . >/dev/null 2>&1; then
  git add graphify-out/graph.json graphify-out/GRAPH_REPORT.md graphify-out/graph.html graphify-out/manifest.json 2>/dev/null
else
  echo "graphify update failed; commit continues without a graph refresh" >&2
fi
exit 0
