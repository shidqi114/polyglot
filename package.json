{
  "name": "polyglot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content": "tsx scripts/build-content.ts",
    "icons": "node scripts/build-icons.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project polyglot-rules-test \"vitest run --config vitest.rules.config.mts\"",
    "test:sync": "SYNC_E2E=1 ALLOW_EMULATOR_BUILD=1 NEXT_PUBLIC_FIREBASE_EMULATOR=1 NEXT_PUBLIC_FIREBASE_API_KEY=demo-key NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-polyglot NEXT_PUBLIC_FIREBASE_APP_ID=demo-app NEXT_DIST_DIR=.next-sync PORT_E2E=3200 sh -c 'next build && firebase emulators:exec --only auth,firestore --project demo-polyglot \"playwright test tests/e2e/sync.spec.ts --project=desktop\"'",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "deploy:rules": "node scripts/deploy-rules.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "packs": "tsx scripts/content/build-packs.ts",
    "topics": "tsx scripts/content/build-topics.ts"
  },
  "dependencies": {
    "@serwist/next": "^9.5.13",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ts-fsrs": "^5.4.2",
    "wanakana": "^5.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "firebase-tools": "^15.34.1",
    "kuromoji": "^0.1.2",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "postcss": "^8.5.23"
  }
}
