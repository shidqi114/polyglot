rules_version = '2';

// Each signed-in user can only read and write their own progress.
// Lesson content ships with the app, so nothing else lives in Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /days/{day} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      match /lessons/{lessonId} {
        allow read, write: if isOwner(uid);
      }

      match /cards/{itemId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && request.resource.data.due is number;
        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
