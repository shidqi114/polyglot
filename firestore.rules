rules_version = '2';

// Each account can read and write only its own progress. Writes are validated field by field,
// so a signed-in client cannot store arbitrary data or oversized values under its own uid.
// Lesson content ships with the app, so nothing else lives in Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function num(v, lo, hi) {
      return v is number && v >= lo && v <= hi;
    }

    // Timestamps in milliseconds since the epoch, up to the year 2100.
    function ms(v) {
      return num(v, 0, 4102444800000);
    }

    function serverTime(data) {
      return !('srv' in data) || data.srv is timestamp;
    }

    function validSettings(s) {
      return s is map
        && s.keys().hasOnly(['dailyGoal', 'theme', 'sound', 'autoplayAudio', 'ttsRate', 'showReadings'])
        && (!('dailyGoal' in s) || num(s.dailyGoal, 1, 1000))
        && (!('theme' in s) || s.theme in ['system', 'light', 'dark'])
        && (!('sound' in s) || s.sound is bool)
        && (!('autoplayAudio' in s) || s.autoplayAudio is bool)
        && (!('ttsRate' in s) || num(s.ttsRate, 0.3, 2))
        && (!('showReadings' in s) || s.showReadings is bool);
    }

    // Item ids: k:<kana>, v:<word>:<reading>, j:<kanji>. Lesson ids: lowercase, short.
    function itemId(id) {
      return id.matches('^[kvj]:[^/]{1,120}$');
    }

    match /users/{uid} {
      allow read, delete: if signedIn(uid);
      allow create, update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['settings', 'settingsUp', 'srv'])
        && (!('settings' in request.resource.data) || validSettings(request.resource.data.settings))
        && (!('settingsUp' in request.resource.data) || ms(request.resource.data.settingsUp))
        && serverTime(request.resource.data);

      match /days/{day} {
        allow read, delete: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['xp', 'lessons', 'reviews', 'srv'])
          && num(request.resource.data.xp, 0, 100000)
          && num(request.resource.data.lessons, 0, 10000)
          && num(request.resource.data.reviews, 0, 10000)
          && serverTime(request.resource.data);
      }

      match /lessons/{lessonId} {
        allow read, delete: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && lessonId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
          && request.resource.data.keys().hasOnly(['done', 'best', 'times', 'up', 'srv'])
          && ms(request.resource.data.done)
          && num(request.resource.data.best, 0, 1)
          && num(request.resource.data.times, 0, 100000)
          && ms(request.resource.data.up)
          && serverTime(request.resource.data);
      }

      match /cards/{itemId} {
        allow read, delete: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && itemId(itemId)
          && request.resource.data.keys().hasOnly(['due', 's', 'd', 'sd', 'ls', 'reps', 'lapses', 'st', 'lr', 'up', 'cf', 'srv'])
          && ms(request.resource.data.due)
          && num(request.resource.data.s, 0, 36500)
          && num(request.resource.data.d, 0, 11)
          && num(request.resource.data.sd, 0, 36500)
          && num(request.resource.data.ls, 0, 10)
          && num(request.resource.data.reps, 0, 100000)
          && num(request.resource.data.lapses, 0, 100000)
          && num(request.resource.data.st, 0, 3)
          && (request.resource.data.lr == null || ms(request.resource.data.lr))
          && ms(request.resource.data.up)
          && (!('cf' in request.resource.data) || (request.resource.data.cf is list && request.resource.data.cf.size() <= 5))
          && serverTime(request.resource.data);
      }

      // Personal notes on a word or kanji (later phase). Text is capped at 2,000 characters.
      match /notes/{itemId} {
        allow read, delete: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && itemId(itemId)
          && request.resource.data.keys().hasOnly(['text', 'up', 'srv'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && ms(request.resource.data.up)
          && serverTime(request.resource.data);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
